<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleDisplayName</key>
    <string>Orvio</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleIconFile</key>
    <string>T1Mark</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Orvio</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.utilities</string>
    <key>LSMinimumSystemVersion</key>
    <string>$(MACOSX_DEPLOYMENT_TARGET)</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>按住说话时，Orvio使用您选定的麦克风接收语音指令。</string>
    <key>NSAudioCaptureUsageDescription</key>
    <string>为系统输出或所选播放器提供音频静音兼容。音频回调不读取、保存或发送音频样本，取消静音或退出应用时解除。</string>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>连接您选择的 Chromecast 遥控器语音服务，在按住语音键时接收麦克风音频，并在松开时停止和转写。</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSScreenCaptureUsageDescription</key>
    <string>执行您的音乐指令时，Orvio读取所选播放器的窗口来定位搜索与播放控件。</string>
    <key>NSSpeechRecognitionUsageDescription</key>
    <string>Orvio可使用系统语音识别将录音转成控制指令。</string>
</dict>
</plist>
