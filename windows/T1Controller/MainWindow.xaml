<Window x:Class="T1Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:T1Controller"
        Title="Orvio控制台" Width="1110" Height="750" MinWidth="930" MinHeight="640"
        Background="#1D2029" Foreground="#F2F4FA" FontFamily="Segoe UI, Microsoft YaHei UI"
        SourceInitialized="OnSourceInitialized" Loaded="ShowFirstRunGuide" Closing="OnClosing" Closed="OnClosed">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX=".72" RadiusY=".9">
                    <GradientStop Color="#406D83BA" Offset="0"/>
                    <GradientStop Color="#006D83BA" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <RadialGradientBrush Center="0,1" GradientOrigin="0,1" RadiusX=".63" RadiusY=".72">
                    <GradientStop Color="#2038969F" Offset="0"/>
                    <GradientStop Color="#0038969F" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Border Background="#C9242731" BorderBrush="#38586374" BorderThickness="0,0,1,0" Padding="13,25,13,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,0,0,21">
                        <Image Source="T1Mark.png" Width="43" Height="43" Margin="0,0,9,0" AutomationProperties.Name="Orvio图标"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Orvio" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="控制台" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="Navigation" SelectedIndex="{Binding SelectedIndex, ElementName=MainTabs, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" AutomationProperties.Name="控制台导航"
                             ItemContainerStyle="{StaticResource NavigationItem}">
                        <ListBoxItem Content="◈   设备导览"/>
                        <ListBoxItem Content="⌨   按键映射"/>
                        <ListBoxItem Content="♫   音乐控制"/>
                        <ListBoxItem Content="▣   主机切换"/>
                        <ListBoxItem Content="◌   语音控制"/>
                    </ListBox>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,0,0,0">
                    <Button Content="设置引导" Click="ShowSetupGuide" HorizontalAlignment="Left"/>
                    <Button Content="隐藏到托盘" Click="HideWindow" HorizontalAlignment="Left"/>
                    <TextBlock Text="本机 Windows" FontWeight="SemiBold" Margin="0,6,0,3"/>
                    <TextBlock x:Name="Overview" Text="等待配置飞鼠" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <Border/>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Bottom" Background="#B8292E39" BorderBrush="#3A727C91" BorderThickness="0,1,0,0" Padding="24,12">
            <TextBlock x:Name="ActionStatus" Text="从「设备导览」选择遥控器，再配置按键。" TextWrapping="Wrap"/>
        </Border>
        <TabControl x:Name="MainTabs" Foreground="#F2F4FA" SelectionChanged="TabChanged" SelectedIndex="0">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent"/>
                </ControlTemplate>
            </TabControl.Template>
            <TabItem Header="设备导览">
                <local:DeviceGuide x:Name="DeviceOverview"/>
            </TabItem>
            <TabItem x:Name="RemoteTab" Header="按键映射">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,20,26,26" TextElement.Foreground="#F2F4FA">
                        <TextBlock Text="按键映射" Style="{StaticResource PageTitle}"/>
                        <GroupBox Header="遥控器模式">
                            <StackPanel>
                                <ComboBox x:Name="ModePicker" DisplayMemberPath="Name" Width="240" HorizontalAlignment="Left"
                                          AutomationProperties.Name="当前遥控器模式" SelectionChanged="ModeSelectionChanged"/>
                                <TextBlock Text="短按独立的模式键，在原生、媒体和主机切换之间循环。同一实体键可在媒体和主机模式承担不同动作。"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="Windows 设备级过滤驱动尚未接通。新组合中的遥控器绑定暂时透传原生功能，映射已暂停。电脑快捷键可切换组合。"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="设备与按键">
                            <StackPanel>
                                <DockPanel>
                                    <Button Content="刷新设备" Click="RefreshDevices" DockPanel.Dock="Right"/>
                                    <ComboBox x:Name="DeviceBox" DisplayMemberPath="DisplayName" AutomationProperties.Name="飞鼠输入设备"
                                              SelectionChanged="DeviceSelectionChanged"/>
                                </DockPanel>
                                <TextBlock x:Name="DevicePath" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <WrapPanel>
                                    <CheckBox x:Name="ProbeEnabled" Content="显示选定设备事件" Checked="ProbeChanged" Unchecked="ProbeChanged"/>
                                    <CheckBox x:Name="NativeVerified" Content="已确认此键无原生动作冲突"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <ComboBox x:Name="RoleBox" Width="220" DisplayMemberPath="Name" AutomationProperties.Name="要学习的功能"/>
                                    <Button Content="学习并按一下" Click="LearnButton"/>
                                    <Button Content="取消学习" Click="CancelLearning"/>
                                    <Button Content="复制诊断" Click="CopyDiagnostics"/>
                                </WrapPanel>
                                <TextBlock x:Name="LearningStatus" Text="选择设备和功能，分别采集一次按下与松开。" TextWrapping="Wrap"/>
                                <ListBox x:Name="InputLog" AutomationProperties.Name="最近按键事件" Height="110" Margin="0,8,0,0"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="已学习的映射">
                            <StackPanel>
                                <WrapPanel>
                                    <CheckBox x:Name="RemappingEnabled" Content="启用现有映射" Checked="MappingChanged" Unchecked="MappingChanged"/>
                                    <CheckBox x:Name="MediaMode" Content="左右键切歌" Checked="MappingChanged" Unchecked="MappingChanged"/>
                                </WrapPanel>
                                <ListBox x:Name="BindingsList" Height="92" DisplayMemberPath="Name" AutomationProperties.Name="已学习映射"/>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="切换映射或透传" Click="ToggleBinding"/>
                                    <Button Content="删除选中映射" Click="RemoveBinding"/>
                                    <Button Content="恢复默认映射" Click="ResetBindings"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="全局快捷键">
                            <StackPanel>
                                <CheckBox x:Name="ModeHotkeys" Content="启用功能组合切换快捷键" Click="SaveGlobalHotkeys"/>
                                <TextBlock Text="Ctrl+Alt+Shift+F10 循环切换 · Ctrl+Alt+Shift+1 原生 · 2 媒体 · 3 主机" TextWrapping="Wrap"/>
                                <CheckBox x:Name="PresetHotkeys" Content="启用 Ctrl+Alt+Shift+F1–F8" Click="SaveGlobalHotkeys"/>
                                <TextBlock Text="F1 上一曲 · F2 播放／暂停 · F3 下一曲 · F4 音量减 · F5 静音 · F6 音量加 · F7 切播放器 · F8 切主机" TextWrapping="Wrap"/>
                                <TextBlock Text="播放 / 暂停（例如 Ctrl+Alt+F10）"/>
                                <TextBox x:Name="PlayPauseHotkey" AutomationProperties.Name="播放暂停快捷键"/>
                                <TextBlock Text="切换主机（例如 Ctrl+Alt+F11）"/>
                                <TextBox x:Name="SwitchHostHotkey" AutomationProperties.Name="切换主机快捷键"/>
                                <Button Content="应用快捷键" Click="SaveGlobalHotkeys" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="音乐控制">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,20,26,26" TextElement.Foreground="#F2F4FA">
                        <TextBlock Text="音乐控制" Style="{StaticResource PageTitle}"/>
                        <GroupBox Header="播放器">
                            <StackPanel>
                                <ComboBox x:Name="PlayerBox" DisplayMemberPath="Name" SelectionChanged="PlayerSelectionChanged"
                                          AutomationProperties.Name="当前播放器"/>
                                <WrapPanel>
                                    <Button Content="打开所选播放器" Click="MusicAction" Tag="OpenPlayer"/>
                                    <Button Content="切换播放器" Click="MusicAction" Tag="NextPlayer"/>
                                    <Button Content="上一曲" Click="MusicAction" Tag="PreviousTrack"/>
                                    <Button Content="播放 / 暂停" Click="MusicAction" Tag="TogglePlayback"/>
                                    <Button Content="下一曲" Click="MusicAction" Tag="NextTrack"/>
                                    <Button Content="每日推荐" Click="MusicAction" Tag="PlayDailyRecommendations"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="音量 −" Click="MusicAction" Tag="VolumeDown"/>
                                    <Button Content="音量 ＋" Click="MusicAction" Tag="VolumeUp"/>
                                    <Button Content="静音 / 取消静音" Click="MusicAction" Tag="ToggleMute"/>
                                </WrapPanel>
                                <CheckBox x:Name="PlayerVolume" Content="优先调整播放器音量" Checked="MusicOptionsChanged" Unchecked="MusicOptionsChanged"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="语音点歌">
                            <StackPanel>
                                <TextBlock Text="支持网易云音乐和汽水音乐。可以说「我想听周杰伦的晴天」或「用汽水音乐播放某位歌手的歌名」。"
                                           TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <CheckBox x:Name="MusicTraceEnabled" Content="保存点歌截图和识别日志" Checked="MusicOptionsChanged" Unchecked="MusicOptionsChanged"/>
                                    <Button Content="查看诊断" Click="OpenMusicDiagnostics"/>
                                </WrapPanel>
                                <TextBlock Text="本地 OCR（备用）"/>
                                <DockPanel>
                                    <Button Content="选择 Tesseract…" Click="BrowseMusicOcr" DockPanel.Dock="Right"/>
                                    <TextBox x:Name="MusicOcrPath" IsReadOnly="True" AutomationProperties.Name="本地 OCR 路径"/>
                                </DockPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="播放器设置">
                            <StackPanel>
                                <TextBlock Text="名称"/>
                                <TextBox x:Name="PlayerName" AutomationProperties.Name="播放器名称"/>
                                <TextBlock Text="应用程序"/>
                                <DockPanel>
                                    <Button Content="选择 exe…" Click="BrowsePlayer" DockPanel.Dock="Right"/>
                                    <TextBox x:Name="PlayerExe" IsReadOnly="True" AutomationProperties.Name="播放器程序路径"/>
                                </DockPanel>
                                <TextBlock Text="目标媒体会话 ID"/>
                                <DockPanel>
                                    <Button Content="刷新正在播放的会话" Click="RefreshSessions" DockPanel.Dock="Right"/>
                                    <ComboBox x:Name="PlayerSession" IsEditable="True" AutomationProperties.Name="媒体会话 ID"/>
                                </DockPanel>
                                <TextBlock Text="可选播放器快捷键（填写该应用实测可用的快捷键）"/>
                                <UniformGrid Columns="3">
                                    <StackPanel><TextBlock Text="播放 / 暂停"/><TextBox x:Name="AppPlayPause" AutomationProperties.Name="应用播放暂停键"/></StackPanel>
                                    <StackPanel><TextBlock Text="上一曲"/><TextBox x:Name="AppPrevious" AutomationProperties.Name="应用上一曲键"/></StackPanel>
                                    <StackPanel><TextBlock Text="下一曲"/><TextBox x:Name="AppNext" AutomationProperties.Name="应用下一曲键"/></StackPanel>
                                </UniformGrid>
                                <TextBlock Text="播放按钮、遥控器与快捷键统一控制列表所选播放器。" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Content="保存播放器" Click="SavePlayer"/>
                                    <Button Content="新增播放器…" Click="AddPlayer"/>
                                    <Button Content="移除播放器" Click="RemovePlayer"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="主机切换">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,20,26,26" TextElement.Foreground="#F2F4FA">
                        <TextBlock Text="主机切换" Style="{StaticResource PageTitle}"/>
                        <GroupBox Header="显示器输入">
                            <StackPanel>
                                <DockPanel>
                                    <Button Content="刷新显示器" Click="RefreshMonitors" DockPanel.Dock="Right"/>
                                    <ComboBox x:Name="MonitorBox" DisplayMemberPath="Name" AutomationProperties.Name="共用显示器"/>
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel><TextBlock Text="Windows 输入代码"/><TextBox x:Name="WindowsInput" AutomationProperties.Name="Windows 输入代码"/></StackPanel>
                                    <StackPanel><TextBlock Text="Mac 输入代码"/><TextBox x:Name="MacInput" AutomationProperties.Name="Mac 输入代码"/></StackPanel>
                                </UniformGrid>
                                <WrapPanel>
                                    <Button Content="读取当前输入" Click="ReadMonitorInput"/>
                                    <Button Content="保存画面和外设设置" Click="SaveSwitch"/>
                                </WrapPanel>
                                <CheckBox x:Name="ToggleWithPeripherals" Content="长按菜单键时同时交接 KMFU 外设"/>
                                <TextBlock x:Name="VideoStatus" Text="先在显示器菜单确认 DDC/CI 已开启。输入代码支持十进制或 0x 十六进制。"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="KMFU 外设交接">
                            <StackPanel>
                                <TextBlock Text="填写已在 KMFU 实测有效的键鼠切换快捷键。只选随主机交接的独立设备作为归属标记。" TextWrapping="Wrap"/>
                                <TextBox x:Name="HubHotkey" AutomationProperties.Name="KMFU 快捷键"/>
                                <ComboBox x:Name="HubDeviceBox" DisplayMemberPath="Name" AutomationProperties.Name="KMFU 归属标记"/>
                                <TextBlock Text="选择随 KMFU 端口交接的共享音响。两个标记仅在 Windows 持有外设时出现。"
                                           TextWrapping="Wrap"/>
                                <DockPanel>
                                    <Button Content="刷新音响" Click="RefreshOutputs" DockPanel.Dock="Right"/>
                                    <ComboBox x:Name="HubOutputBox" DisplayMemberPath="Name" AutomationProperties.Name="KMFU 共享音响"/>
                                </DockPanel>
                                <Button Content="确认外设当前均在 Windows" Click="ConfirmHubOwner" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="HubStatus" Text="请核对键鼠、音响与飞鼠接收器在 KMFU 中的端口跟随设置。"
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="执行切换">
                            <StackPanel>
                                <WrapPanel>
                                    <Button Content="全部切到 Windows" Tag="Windows" Click="SwitchHost"/>
                                    <Button Content="全部切到 Mac" Tag="Mac" Click="SwitchHost"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="仅画面到 Windows" Tag="Windows" Click="DisplayOnly"/>
                                    <Button Content="仅画面到 Mac" Tag="Mac" Click="DisplayOnly"/>
                                    <Button Content="仅请求 KMFU 交给 Mac" Click="HubOnly"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="VoiceTab" Header="语音控制">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="26,20,26,26" TextElement.Foreground="#F2F4FA">
                        <TextBlock Text="语音控制" Style="{StaticResource PageTitle}"/>
                        <GroupBox Header="录音设备与本地识别">
                            <StackPanel>
                                <DockPanel>
                                    <Button Content="刷新麦克风" Click="RefreshMicrophones" DockPanel.Dock="Right"/>
                                    <ComboBox x:Name="MicrophoneBox" DisplayMemberPath="Name" AutomationProperties.Name="录音设备"/>
                                </DockPanel>
                                <TextBlock Text="whisper-cli.exe"/>
                                <DockPanel>
                                    <Button Content="选择程序…" Click="BrowseWhisper" DockPanel.Dock="Right"/>
                                    <TextBox x:Name="WhisperExe" IsReadOnly="True" AutomationProperties.Name="本地识别程序"/>
                                </DockPanel>
                                <TextBlock Text="支持中文的多语种模型"/>
                                <DockPanel>
                                    <Button Content="选择模型…" Click="BrowseModel" DockPanel.Dock="Right"/>
                                    <TextBox x:Name="WhisperModel" IsReadOnly="True" AutomationProperties.Name="识别模型"/>
                                </DockPanel>
                                <WrapPanel>
                                    <Button Content="保存语音设置" Click="SaveVoice"/>
                                    <Button x:Name="ProbeVoiceButton" Content="按住试录" Tag="probe" PreviewMouseLeftButtonDown="VoiceDown"
                                            PreviewMouseLeftButtonUp="VoiceUp" LostMouseCapture="VoiceLostCapture"
                                            PreviewKeyDown="VoiceKeyDown" PreviewKeyUp="VoiceKeyUp" LostKeyboardFocus="VoiceLostFocus"/>
                                    <Button x:Name="PushToTalkButton" Content="按住说话" Tag="talk" PreviewMouseLeftButtonDown="VoiceDown"
                                            PreviewMouseLeftButtonUp="VoiceUp" LostMouseCapture="VoiceLostCapture"
                                            PreviewKeyDown="VoiceKeyDown" PreviewKeyUp="VoiceKeyUp" LostKeyboardFocus="VoiceLostFocus"/>
                                </WrapPanel>
                                <CheckBox x:Name="KeyboardVoice" Content="使用 Ctrl+Alt+Shift+F9 按住说话" Click="SaveGlobalHotkeys"/>
                                <TextBlock x:Name="VoiceStatus" Text="选择系统默认输入或已验证的 T1 麦克风。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="测试中文指令">
                            <StackPanel>
                                <TextBox x:Name="TextCommand" AutomationProperties.Name="中文指令"/>
                                <Button Content="执行指令" Click="RunTextCommand" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="小爱同学">
                            <StackPanel>
                                <CheckBox x:Name="XiaoAIEnabled" Content="使用「小爱同学」开头时调用小爱音箱"/>
                                <TextBlock Text="Home Assistant 地址"/>
                                <TextBox x:Name="XiaoAIAddress" AutomationProperties.Name="Home Assistant 地址"/>
                                <TextBlock Text="音箱的执行文本指令实体"/>
                                <TextBox x:Name="XiaoAIEntity" AutomationProperties.Name="音箱的执行文本指令实体"/>
                                <TextBlock Text="巴法开关主题"/>
                                <TextBox x:Name="XiaoAITopic" AutomationProperties.Name="巴法开关主题"/>
                                <TextBlock Text="交给小爱的固定口令"/>
                                <TextBox x:Name="XiaoAICommand" AutomationProperties.Name="交给小爱的固定口令"/>
                                <CheckBox x:Name="XiaoAISilent" Content="发送静默执行参数"/>
                                <DockPanel>
                                    <Button Content="选择 Python 3…" Click="BrowseXiaoAIPython" DockPanel.Dock="Right"/>
                                    <TextBox x:Name="XiaoAIPython" IsReadOnly="True" AutomationProperties.Name="Python 3 路径"/>
                                </DockPanel>
                                <TextBlock Text="巴法 UID"/>
                                <PasswordBox x:Name="BemfaSecret" AutomationProperties.Name="巴法 UID" Margin="0,4,8,8"/>
                                <TextBlock Text="Home Assistant 令牌"/>
                                <PasswordBox x:Name="HAToken" AutomationProperties.Name="Home Assistant 令牌" Margin="0,4,8,8"/>
                                <WrapPanel>
                                    <Button Content="保存小爱设置" Click="SaveXiaoAI"/>
                                    <Button Content="清除本机凭据" Click="ClearXiaoAI"/>
                                    <Button Content="测试小爱并播放" Click="TestXiaoAI"/>
                                </WrapPanel>
                                <TextBlock x:Name="XiaoAIStatus" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        </DockPanel>
    </Grid>
</Window>
